<?xml version="1.0" ?>
<!--
  Near-field test range (report Fig. 2).
  ENU: x = east, y = north, z = up. The AUT aperture lies in the x = 0 plane facing +x;
  its centre is at (0, 0, 4). The drone starts 6 m east of the AUT, facing west (towards it).
-->
<sdf version="1.9">
  <world name="nf_range">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <!--WIND_PLUGIN-->

    <scene>
      <ambient>0.9 0.9 0.9</ambient>
      <background>0.75 0.85 0.95</background>
      <sky></sky>
      <grid>false</grid>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.45 0.55 0.4 1</ambient><diffuse>0.45 0.55 0.4 1</diffuse></material>
        </visual>
        <visual name="pad">
          <pose>6 0 0.005 0 0 0</pose>
          <geometry><box><size>2 2 0.01</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Antenna under test: 1 m x 1 m aperture on a mast, facing +x -->
    <model name="aut">
      <static>true</static>
      <link name="link">
        <visual name="mast">
          <pose>-0.15 0 1.75 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>3.5</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
        <visual name="aperture">
          <pose>0 0 4 0 0 0</pose>
          <geometry><box><size>0.05 1.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.9 1</ambient><diffuse>0.6 0.4 0.9 1</diffuse></material>
        </visual>
        <collision name="aperture_col">
          <pose>0 0 4 0 0 0</pose>
          <geometry><box><size>0.05 1.0 1.0</size></box></geometry>
        </collision>
        <collision name="mast_col">
          <pose>-0.15 0 1.75 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>3.5</length></cylinder></geometry>
        </collision>
        <visual name="rf_source">
          <pose>-0.6 0.6 0.3 0 0 0</pose>
          <geometry><box><size>0.4 0.3 0.6</size></box></geometry>
          <material><ambient>0.7 0.6 0.95 1</ambient><diffuse>0.7 0.6 0.95 1</diffuse></material>
        </visual>
        <!-- planar scan surface outline (3 m x 3 m at x = 1 m) -->
        <visual name="scan_plane">
          <pose>1.0 0 4 0 0 0</pose>
          <geometry><box><size>0.002 3.0 3.0</size></box></geometry>
          <material><ambient>0.2 0.4 1 0.15</ambient><diffuse>0.2 0.4 1 0.15</diffuse></material>
          <transparency>0.85</transparency>
        </visual>
      </link>
    </model>

    <!-- RTK base station and GCS (visual only) -->
    <model name="rtk_base">
      <static>true</static>
      <pose>4 -4 0 0 0 0</pose>
      <link name="link">
        <visual name="pole"><pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>1.5</length></cylinder></geometry></visual>
        <visual name="antenna"><pose>0 0 1.52 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.6 0.4 0.9 1</ambient><diffuse>0.6 0.4 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="gcs">
      <static>true</static>
      <pose>9 -3 0 0 0 0</pose>
      <link name="link">
        <visual name="table"><pose>0 0 0.4 0 0 0</pose>
          <geometry><box><size>1.0 0.6 0.8</size></box></geometry>
          <material><ambient>0.7 0.6 0.95 1</ambient><diffuse>0.7 0.6 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <uri>model://MODEL_NAME</uri>
      <pose degrees="true">6 0 0.40 0 0 180</pose>
    </include>
  </world>
</sdf>
