# ArduCopter parameters for the near-field measurement hexacopter (SITL + Gazebo).
# Starting point for a ~15.7 kg Hexa-X on 24 in props; values follow ArduPilot's
# "initial tune" guidance for large props and are expected to be refined (AUTOTUNE).

# --- frame
FRAME_CLASS     2       # Hexa
FRAME_TYPE      1       # X

# --- motors (ArduPilotPlugin maps 1100-1900 us linearly to rotor speed; thrust ~ w^2)
MOT_PWM_MIN     1100
MOT_PWM_MAX     1900
MOT_SPIN_ARM    0.08
MOT_SPIN_MIN    0.12
MOT_THST_EXPO   0.8
MOT_THST_HOVER  0.55
MOT_HOVER_LEARN 2

# --- filtering for 24 in props (gyro LPF ~ 289 * prop^-0.838 Hz)
INS_GYRO_FILTER 20
ATC_RAT_RLL_FLTD 10
ATC_RAT_RLL_FLTT 10
ATC_RAT_PIT_FLTD 10
ATC_RAT_PIT_FLTT 10
ATC_RAT_YAW_FLTE 2
ATC_RAT_YAW_FLTT 10

# --- attitude controller (large, slow airframe)
ATC_ACCEL_R_MAX 20000
ATC_ACCEL_P_MAX 20000
ATC_ACCEL_Y_MAX 8000
ATC_RAT_RLL_P   0.10
ATC_RAT_RLL_I   0.10
ATC_RAT_RLL_D   0.004
ATC_RAT_PIT_P   0.10
ATC_RAT_PIT_I   0.10
ATC_RAT_PIT_D   0.004
ATC_RAT_YAW_P   0.30
ATC_RAT_YAW_I   0.03
ACRO_YAW_P      2.0

# --- scan-friendly navigation: slow, smooth, fixed heading towards the AUT
WPNAV_SPEED     50      # cm/s along the raster lines
WPNAV_ACCEL     50
WPNAV_SPEED_UP  50
WPNAV_SPEED_DN  50
WPNAV_RADIUS    10
WP_YAW_BEHAVIOR 0       # never change yaw during the mission
LOIT_SPEED      100
ANGLE_MAX       2500

# --- sensors in the architecture
# Down-facing rangefinder: on the real drone RNGFND1_TYPE is set for the chosen sensor.
# Disabled here: ArduPilotPlugin (JSON) does not feed rangefinder data to SITL.
RNGFND1_TYPE    0
SIM_FLOW_ENABLE 1
FLOW_TYPE       10      # SITL optical flow (stands in for HereFlow)
EK3_SRC1_POSXY  3       # GPS (RTK on the real build)
EK3_SRC1_VELXY  3
EK3_SRC1_POSZ   1       # baro
SIM_GPS_HZ      10      # RTK receivers typically 5-20 Hz

# --- battery: 12S 22 Ah
BATT_CAPACITY   22000

# --- logging: log at full rate for the position-error study
LOG_BITMASK     180222
LOG_DISARMED    0
