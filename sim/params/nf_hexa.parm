# ArduCopter parameters for the near-field measurement hexacopter (SITL + Gazebo, CATR lab).
# Starting point for a ~15.7 kg Hexa-X on 24 in props; values follow ArduPilot's
# "initial tune" guidance for large props and are expected to be refined (AUTOTUNE).

# --- frame
FRAME_CLASS     2       # Hexa
FRAME_TYPE      1       # X

# --- motors (ArduPilotPlugin maps 1100-1900 us linearly to rotor speed; thrust ~ w^2)
MOT_PWM_MIN     1100
MOT_PWM_MAX     1900
MOT_SPIN_ARM    0.08
MOT_SPIN_MIN    0.12
MOT_THST_EXPO   0.8
MOT_THST_HOVER  0.55
MOT_HOVER_LEARN 2

# --- filtering for 24 in props (gyro LPF ~ 289 * prop^-0.838 Hz)
INS_GYRO_FILTER 20
ATC_RAT_RLL_FLTD 10
ATC_RAT_RLL_FLTT 10
ATC_RAT_PIT_FLTD 10
ATC_RAT_PIT_FLTT 10
ATC_RAT_YAW_FLTE 2
ATC_RAT_YAW_FLTT 10

# --- attitude controller (large, slow airframe)
# The probe boom makes pitch inertia ~3x roll (Iyy ~2.7 vs Ixx ~0.85 kg m^2), so pitch
# rate gains are ~3x roll. With equal gains the pitch loop oscillated with a ~2 s
# period and grew until the drone crashed (rate output only ~0.2 for 150 deg/s error).
ATC_ACCEL_R_MAX 20000
ATC_ACCEL_P_MAX 20000
ATC_ACCEL_Y_MAX 8000
ATC_RAT_RLL_P   0.15
ATC_RAT_RLL_I   0.15
ATC_RAT_RLL_D   0.006
ATC_RAT_PIT_P   0.35
ATC_RAT_PIT_I   0.35
ATC_RAT_PIT_D   0.014
ATC_RAT_YAW_P   0.30
ATC_RAT_YAW_I   0.03
ACRO_YAW_P      2.0

# --- scan-friendly navigation: slow, smooth, fixed heading towards the AUT
WPNAV_SPEED     50      # cm/s along the raster lines
WPNAV_ACCEL     50
WPNAV_SPEED_UP  50
WPNAV_SPEED_DN  50
WPNAV_RADIUS    10
WP_YAW_BEHAVIOR 0       # never change yaw during the mission
LOIT_SPEED      100
ANGLE_MAX       2500

# --- sensors: indoor CATR lab, no GNSS
GPS1_TYPE       0       # no GPS indoors
# UWB position from uwb_extnav.py (VISION_POSITION_ESTIMATE on SERIAL1)
VISO_TYPE       1       # MAVLink
VISO_DELAY_MS   50      # UWB fix latency
VISO_POS_M_NSE  0.05
VISO_POS_X      -0.05   # UWB tag on the top-deck mast, body FRD (catr_layout.UWB_TAG_OFFSET)
VISO_POS_Y      0
VISO_POS_Z      -0.31
# Down-facing rangefinder: Gazebo lidar on the model -> ArduPilotPlugin rng_1 -> SITL
# (the real build sets the chosen sensor's type). Over the floor absorber it reads the
# pyramid tips and valleys, so it is not used for height.
RNGFND1_TYPE    100
RNGFND1_ORIENT  25      # down
RNGFND1_MIN_CM  10
RNGFND1_MAX_CM  2000
RNGFND1_GNDCLEAR 23     # reading on the ground (sensor 0.23 m above the floor)
SIM_FLOW_ENABLE 1
FLOW_TYPE       10      # SITL optical flow (stands in for HereFlow)
EK3_SRC1_POSXY  6       # ExternalNav (UWB)
EK3_SRC1_VELXY  5       # OpticalFlow (HereFlow), scaled by the rangefinder height
EK3_SRC1_POSZ   6       # ExternalNav (UWB): rangefinder is unusable over pyramidal floor absorber
EK3_SRC1_VELZ   0
EK3_SRC1_YAW    1       # compass

# --- battery: 12S 22 Ah
BATT_CAPACITY   22000

# --- logging: log at full rate for the position-error study
LOG_BITMASK     180222
LOG_DISARMED    0
